---
import ToolLayout from '../../../layouts/ToolLayout.astro';
import SampleStarterTool from '../../../components/tools/SampleStarterTool.astro';
import { tools, type ToolItem } from '../../../data/tools';

export async function getStaticPaths() {
  return tools.map((tool) => ({
    params: { slug: tool.id },
    props: { tool },
  }));
}

export interface Props {
  tool: ToolItem;
}

const { tool } = Astro.props;
---

<ToolLayout tool={tool} lang="id">
  {tool.id === 'starter-card' && <SampleStarterTool lang="id" />}
</ToolLayout>
