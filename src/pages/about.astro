---
import Layout from '../layouts/Layout.astro';

const title = 'About — Muh. Dimas Januardi Nur';
const description =
  'Full-stack developer based in Makassar, Indonesia, working across web, mobile, and infrastructure.';

const tools = ['TypeScript', 'JavaScript', 'React', 'Next.js', 'Flutter', 'Dart', 'Node.js', 'Supabase', 'Docker', 'Figma'];
---

<Layout title={title} description={description}>
  <section class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
    <h1 class="font-display text-4xl sm:text-5xl">About</h1>

    <div class="mt-8 max-w-[65ch] space-y-5 text-lg leading-relaxed text-ink/80">
      <p>
        I'm Dimas — a full-stack developer based in Makassar, Indonesia, working across web,
        mobile, and the infrastructure that ties them together. Most of what I build runs on
        Next.js and Supabase on the web side and Flutter on mobile, with Docker and GitHub
        Actions handling the parts nobody wants to think about after launch.
      </p>
      <p>
        In 2025, my team and I published our work on FOKUS!, a scheduling app we built and
        tested over three Agile sprints, in the Journal of Embedded Systems, Security and
        Intelligent Systems — writing up the process taught me almost as much as building the
        thing did.
      </p>
      <p>
        Online I mostly go by <strong>InYrDim</strong> — short for "in your dream." Ship fast,
        iterate, improve is more or less the whole philosophy.
      </p>
    </div>

    <h2 class="mt-14 font-display text-2xl">Tools I reach for</h2>
    <ul class="mt-5 flex flex-wrap gap-2">
      {tools.map((tool) => (
        <li class="rounded-full border border-line px-3 py-1 text-sm text-muted">{tool}</li>
      ))}
    </ul>
  </section>
</Layout>
