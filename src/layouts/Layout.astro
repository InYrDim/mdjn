---
import SEO from '../components/SEO.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import type { Lang } from '../i18n/utils';

export interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  lang?: Lang;
  /** Canonical, locale-agnostic path for this page: "/", "/about", "/projects/fokus". Powers hreflang + the language switcher. */
  path?: string;
  /** Pass a subset when this exact page isn't translated into every locale yet (e.g. a single-language blog post). */
  availableLangs?: Lang[];
}

const { title, description, image, type, noindex, lang = 'en', path = '/', availableLangs } = Astro.props;
const rssHref = lang === 'id' ? '/id/rss.xml' : '/rss.xml';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Set the theme before first paint so dark mode never flashes. -->
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {}
        var theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;
      })();
      document.addEventListener('astro:after-swap', function () {
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {}
        var theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;
      });
    </script>

    <link rel="alternate" type="application/rss+xml" title="Muh. Dimas Januardi Nur — Blog" href={rssHref} />

    <ClientRouter />

    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      noindex={noindex}
      lang={lang}
      path={path}
      availableLangs={availableLangs}
    />
    <slot name="head" />
  </head>
  <body class="bg-paper font-sans text-ink antialiased">
    <SiteHeader lang={lang} path={path} availableLangs={availableLangs} />
    <main>
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>
