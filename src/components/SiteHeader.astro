---
import ThemeToggle from './ThemeToggle.astro';
import { useTranslations, translatePath, type Lang } from '../i18n/utils';

export interface Props {
  lang: Lang;
  /** Canonical, locale-agnostic path of the current page. The switcher links to this same page in the other language. */
  path?: string;
  /** Which locales actually have this exact page. Omit when it's available everywhere (the default for every page except blog posts). */
  availableLangs?: Lang[];
}

const { lang, path = '/', availableLangs } = Astro.props;
const t = useTranslations(lang);
const tp = (p: string) => translatePath(p, lang);

const navItems = [
  { href: '/#work', key: 'nav.work' },
  { href: '/blog', key: 'nav.blog' },
  { href: '/artifacts', key: 'nav.artifacts' },
  { href: '/about', key: 'nav.about' },
  { href: '/#contact', key: 'nav.contact' },
] as const;

const switcher = [
  { code: 'en' as const, label: 'EN' },
  { code: 'id' as const, label: 'ID' },
];

const switchHref = (code: Lang) => {
  const isAvailable = !availableLangs || availableLangs.includes(code);
  return isAvailable ? translatePath(path, code) : translatePath('/blog', code);
};
---

<header class="sticky top-0 z-30 border-b border-line bg-paper/90 backdrop-blur-sm">
  <div class="mx-auto flex h-16 max-w-4xl items-center justify-between px-6">
    <a href={tp('/')} class="font-display text-lg font-medium tracking-tight">
      InYrDim
    </a>

    <!-- Desktop nav: single line, 5 items + controls fit comfortably at h-16. -->
    <nav class="hidden items-center gap-6 text-sm md:flex" aria-label="Main">
      {
        navItems.map((item) => (
          <a href={tp(item.href)} class="text-ink/80 transition-colors hover:text-ink">
            {t(item.key)}
          </a>
        ))
      }
      <span class="h-4 w-px bg-line" aria-hidden="true"></span>
      <div class="flex items-center gap-2">
        {
          switcher.map((s, i) => {
            const isAvailable = !availableLangs || availableLangs.includes(s.code);
            return (
              <>
                {i > 0 && <span class="text-line">/</span>}
                <a
                  href={switchHref(s.code)}
                  title={isAvailable ? undefined : `Not translated yet, showing the ${s.label} blog`}
                  class:list={['transition-colors', lang === s.code ? 'text-ink' : 'text-muted hover:text-ink']}
                  aria-current={lang === s.code ? 'true' : undefined}
                >
                  {s.label}
                </a>
              </>
            );
          })
        }
      </div>
      <ThemeToggle />
    </nav>

    <!-- Mobile: theme toggle + menu button only; links collapse into a panel. -->
    <div class="flex items-center gap-1 md:hidden">
      <ThemeToggle />
      <button
        type="button"
        class="menu-button inline-flex h-9 w-9 items-center justify-center rounded-sm text-ink/70 transition-colors hover:bg-ink/[0.06] hover:text-ink"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Menu"
      >
        <svg class="icon-open" width="18" height="18" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
          <path d="M224,128a8,8,0,0,1-8,8H40a8,8,0,0,1,0-16H216A8,8,0,0,1,224,128ZM40,72H216a8,8,0,0,0,0-16H40a8,8,0,0,0,0,16Zm176,96H40a8,8,0,0,0,0,16H216a8,8,0,0,0,0-16Z"></path>
        </svg>
        <svg class="icon-close hidden" width="18" height="18" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
          <path d="M208.49,191.51a12,12,0,0,1-17,17L128,145,64.49,208.49a12,12,0,0,1-17-17L111,128,47.51,64.49a12,12,0,0,1,17-17L128,111l63.51-63.52a12,12,0,0,1,17,17L145,128l63.49,63.51Z"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile panel: checkbox-free, JS toggles the hidden attribute. -->
  <nav id="mobile-nav" class="hidden border-t border-line bg-paper md:hidden" aria-label="Mobile">
    <div class="mx-auto max-w-4xl px-6 py-4">
      {
        navItems.map((item) => (
          <a href={tp(item.href)} class="mobile-link block py-2.5 text-ink/80">
            {t(item.key)}
          </a>
        ))
      }
      <div class="mt-3 flex items-center gap-3 border-t border-line pt-4 text-sm">
        {
          switcher.map((s, i) => (
            <>
              {i > 0 && <span class="text-line">/</span>}
              <a href={switchHref(s.code)} class:list={[lang === s.code ? 'text-ink' : 'text-muted']}>
                {s.label}
              </a>
            </>
          ))
        }
      </div>
    </div>
  </nav>
</header>

<script>
  // Fully delegated so it keeps working after Astro view-transition swaps:
  // the DOM is replaced on navigation, but document-level listeners survive.
  function closeMobileNav() {
    const panel = document.querySelector('#mobile-nav');
    const button = document.querySelector('.menu-button');
    if (!panel || !button) return;
    panel.classList.add('hidden');
    button.setAttribute('aria-expanded', 'false');
    button.querySelector('.icon-open')?.classList.remove('hidden');
    button.querySelector('.icon-close')?.classList.add('hidden');
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    if (!target) return;

    if (target.closest('.menu-button')) {
      const panel = document.querySelector('#mobile-nav');
      const button = document.querySelector('.menu-button');
      if (!panel || !button) return;
      const open = panel.classList.toggle('hidden') === false;
      button.setAttribute('aria-expanded', String(open));
      button.querySelector('.icon-open')?.classList.toggle('hidden', open);
      button.querySelector('.icon-close')?.classList.toggle('hidden', !open);
      return;
    }

    // Any link inside the panel closes it (covers nav + language switch).
    if (target.closest('#mobile-nav a')) closeMobileNav();
  });

  document.addEventListener('astro:after-swap', closeMobileNav);
</script>
