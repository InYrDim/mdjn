---
// Central place for all per-page SEO tags: title, description, canonical URL,
// hreflang alternates for the other locale, Open Graph, and Twitter Cards.
import { translatePath, type Lang } from '../i18n/utils';

/** Site-wide fallback preview image (1200x630, in /public). Used whenever a page doesn't pass its own `image`. */
const DEFAULT_OG_IMAGE = '/og-image.png';

export interface Props {
  title: string;
  description: string;
  /** Path to a 1200x630 image in /public, e.g. "/og-image.jpg". Falls back to the site default. */
  image?: string;
  type?: 'website' | 'article' | 'profile';
  /** Set true on pages you don't want indexed (drafts, thank-you pages, etc). */
  noindex?: boolean;
  lang?: Lang;
  /** Canonical, locale-agnostic path used to build hreflang alternates: "/", "/about", "/projects/fokus". */
  path?: string;
  /** Which locales actually have a version of this exact page. Defaults to all locales — pass a subset for content (like blog posts) that isn't translated yet. */
  availableLangs?: Lang[];
}

const {
  title,
  description,
  image,
  type = 'website',
  noindex = false,
  lang = 'en',
  path = '/',
  availableLangs,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image ?? DEFAULT_OG_IMAGE, Astro.site);

// Keep this in sync with astro.config.mjs -> i18n.locales
const ogLocales = { en: 'en_US', id: 'id_ID' } as const;
const allLangs = Object.keys(ogLocales) as Lang[];
const alternateLangs = allLangs.filter((l) => l !== lang);

// Only advertise hreflang alternates for locales that actually have this page.
const hreflangLangs = availableLangs ?? allLangs;
const showHreflang = hreflangLangs.length > 1;
const xDefaultLang = hreflangLangs.includes('en') ? 'en' : hreflangLangs[0];
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Tell search engines this page has versions in other languages, so they're
     treated as translations of each other rather than duplicate content.
     Skipped when this content (e.g. an untranslated blog post) only exists in one language. -->
{showHreflang && hreflangLangs.map((l) => (
  <link rel="alternate" hreflang={l} href={new URL(translatePath(path, l), Astro.site)} />
))}
{showHreflang && <link rel="alternate" hreflang="x-default" href={new URL(translatePath(path, xDefaultLang), Astro.site)} />}

<!-- Open Graph (Facebook, LinkedIn, Slack unfurls, etc.) -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={ogLocales[lang]} />
{alternateLangs.map((l) => <meta property="og:locale:alternate" content={ogLocales[l]} />)}
<meta property="og:image" content={imageURL} />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
