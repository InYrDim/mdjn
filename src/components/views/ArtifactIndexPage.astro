---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { useTranslations, useTranslatedPath, type Lang } from '../../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

const allArtifacts = await getCollection('artifacts', ({ data }) => !data.draft);
const artifacts = allArtifacts
  .filter((artifact) => artifact.data.lang === lang)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Group by `type`, keeping a stable, sensible category order.
const typeOrder = ['iso', 'cheatsheet', 'document', 'tool', 'other'] as const;
type ArtifactType = (typeof typeOrder)[number];
const grouped = new Map<ArtifactType, typeof artifacts>();
for (const artifact of artifacts) {
  const list = grouped.get(artifact.data.type) ?? [];
  list.push(artifact);
  grouped.set(artifact.data.type, list);
}
const groups = [...grouped.entries()].sort(
  (a, b) => typeOrder.indexOf(a[0]) - typeOrder.indexOf(b[0]),
);

const dateFormatter = new Intl.DateTimeFormat(lang === 'id' ? 'id-ID' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={t('artifacts.title')} description={t('artifacts.description')} lang={lang} path="/artifacts">
  <section class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
    <h1 class="font-display text-4xl sm:text-5xl">{t('artifacts.heading')}</h1>
    <p class="mt-4 max-w-[60ch] text-ink/70">{t('artifacts.description')}</p>

    <nav aria-label={t('artifacts.heading')} class="mt-8 flex flex-wrap gap-2">
      {
        groups.map(([type, list]) => (
          <a
            href={`#${type}`}
            class="rounded-sm border border-line px-2.5 py-1 text-xs text-muted transition-colors hover:border-accent hover:text-accent"
          >
            {t(`artifact.type.${type}`)}
            <span class="ml-1 tabular-nums opacity-60">{list.length}</span>
          </a>
        ))
      }
    </nav>

    {
      artifacts.length === 0 ? (
        <p class="mt-10 text-ink/70">{t('artifacts.empty')}</p>
      ) : (
        <div class="mt-10 space-y-12">
          {groups.map(([type, list]) => (
            <section id={type} class="scroll-mt-24">
              <h2 class="flex items-baseline gap-3 font-display text-2xl">
                {t(`artifact.type.${type}`)}
                <span class="text-sm font-normal text-muted">{list.length}</span>
              </h2>
              <div class="mt-4 border-t border-line">
                {list.map((artifact) => (
                  <a
                    href={tp(`/artifacts/${artifact.id.split('/').pop()}`)}
                    class="group block border-b border-line py-6 transition-colors hover:bg-ink/[0.03]"
                  >
                    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                      <h3 class="font-display text-xl group-hover:text-accent">{artifact.data.title}</h3>
                      <time datetime={artifact.data.pubDate.toISOString()} class="text-sm text-muted">
                        {dateFormatter.format(artifact.data.pubDate)}
                      </time>
                    </div>
                    <p class="mt-2 max-w-[60ch] text-ink/70">{artifact.data.description}</p>
                    <ul class="mt-3 flex flex-wrap items-center gap-2">
                      <li class="rounded-sm bg-ink/[0.06] px-2.5 py-1 text-xs font-medium text-ink/80">
                        {t(`artifact.type.${artifact.data.type}`)}
                      </li>
                      {artifact.data.size && (
                        <li class="rounded-sm border border-line px-2.5 py-1 text-xs text-muted">
                          {artifact.data.size}
                        </li>
                      )}
                      {artifact.data.tags.map((tag) => (
                        <li class="rounded-sm border border-line px-2.5 py-1 text-xs text-muted">{tag}</li>
                      ))}
                    </ul>
                  </a>
                ))}
              </div>
            </section>
          ))}
        </div>
      )
    }
  </section>
</Layout>
