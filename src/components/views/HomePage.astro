---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects.js';
import { getCollection } from 'astro:content';
import { useTranslations, useTranslatedPath, type Lang } from '../../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft && data.lang === lang))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const dateFormatter = new Intl.DateTimeFormat(lang === 'id' ? 'id-ID' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const name = 'Muh. Dimas Januardi Nur';
const role = t('hero.role');
const intro = t('hero.intro');

// Person structured data helps Google show a knowledge panel / rich result
// for your name and ties your site to your other profiles.
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name,
  url: Astro.site?.toString(),
  jobTitle: role,
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Universitas Negeri Makassar',
  },
  sameAs: [
    'https://github.com/InYrDim',
    'https://id.linkedin.com/in/muh-dimas-januardi-nur',
    'https://instagram.com/dms_jn',
  ],
};
---

<Layout title={`${name} - ${role}`} description={intro} lang={lang} path="/">
  <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

  <section class="mx-auto max-w-4xl px-6 pt-16 pb-20 sm:pt-24 sm:pb-28">
    <div class="flex items-center gap-3 text-sm text-muted">
      <span>{t('hero.location')}</span>
      <span class="h-3 w-px bg-line" aria-hidden="true"></span>
      <span class="flex items-center gap-2">
        {/* Accent dot marks live availability - semantic, not decoration. */}
        <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        {t('hero.status')}
      </span>
    </div>
    <h1 class="mt-6 font-display text-5xl leading-[1.05] sm:text-6xl">
      {name}, {role.toLowerCase()}.
    </h1>
    <p class="mt-6 max-w-[60ch] text-lg leading-relaxed text-ink/80">
      {intro}
    </p>
  </section>

  <section id="work" class="mx-auto max-w-4xl px-6 pb-24">
    <h2 class="font-display text-2xl">{t('work.heading')}</h2>
    <div class="mt-8 border-t border-line">
      {
        projects.map((project) => {
          const p = project[lang];
          return (
            <a
              href={tp(`/projects/${project.slug}`)}
              class="group block border-b border-line py-6 transition-colors hover:bg-ink/[0.03]"
            >
              <div>
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h3 class="font-display text-xl group-hover:text-accent">{project.title}</h3>
                  <span class="font-mono text-sm text-muted">{p.year}</span>
                </div>
                <p class="mt-2 max-w-[60ch] text-ink/70">{p.description}</p>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {project.stack.map((tech) => (
                    <li class="rounded-sm border border-line px-2.5 py-1 text-xs text-muted">{tech}</li>
                  ))}
                </ul>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>

  {
    latestPosts.length > 0 && (
      <section class="mx-auto max-w-4xl px-6 pb-24">
        <div class="flex items-baseline justify-between">
          <h2 class="font-display text-2xl">{t('home.latestHeading')}</h2>
          <a href={tp('/blog')} class="text-sm text-muted hover:text-accent">
            {t('home.viewAllPosts')}
          </a>
        </div>
        <div class="mt-8 border-t border-line">
          {latestPosts.map((post) => (
            <a
              href={tp(`/blog/${post.id.split('/').pop()}`)}
              class="group flex items-baseline justify-between gap-4 border-b border-line py-5 transition-colors hover:bg-ink/[0.03]"
            >
              <h3 class="font-display text-lg group-hover:text-accent">{post.data.title}</h3>
              <time datetime={post.data.pubDate.toISOString()} class="shrink-0 text-sm text-muted">
                {dateFormatter.format(post.data.pubDate)}
              </time>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section id="contact" class="mx-auto max-w-4xl px-6 pb-28">
    <h2 class="font-display text-2xl">{t('contact.heading')}</h2>
    <p class="mt-4 max-w-[60ch] text-ink/80">
      {t('contact.body')}
    </p>
    <a
      href="mailto:muhdimasjanuardinur@gmail.com"
      class="mt-4 inline-block text-accent underline decoration-line hover:decoration-accent"
    >
      muhdimasjanuardinur@gmail.com
    </a>
  </section>
</Layout>
