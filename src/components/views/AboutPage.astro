---
import Layout from '../../layouts/Layout.astro';
import { useTranslations, type Lang } from '../../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const tools = ['TypeScript', 'JavaScript', 'React', 'Next.js', 'Flutter', 'Dart', 'Node.js', 'Supabase', 'Docker', 'Figma'];
---

<Layout title={t('about.title')} description={t('about.description')} lang={lang} path="/about">
  <section class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
    <h1 class="font-display text-4xl sm:text-5xl">{t('about.heading')}</h1>

    <div class="mt-8 max-w-[65ch] space-y-5 text-lg leading-relaxed text-ink/80">
      <p>{t('about.p1')}</p>
      <p>{t('about.p2')}</p>
      <p>{t('about.p3')}</p>
    </div>

    <h2 class="mt-14 font-display text-2xl">{t('about.toolsHeading')}</h2>
    <ul class="mt-5 flex flex-wrap gap-2">
      {tools.map((tool) => (
        <li class="rounded-full border border-line px-3 py-1 text-sm text-muted">{tool}</li>
      ))}
    </ul>
  </section>
</Layout>
