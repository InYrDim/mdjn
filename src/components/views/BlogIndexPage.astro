---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { useTranslations, useTranslatedPath, type Lang } from '../../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts
  .filter((post) => post.data.lang === lang)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const dateFormatter = new Intl.DateTimeFormat(lang === 'id' ? 'id-ID' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={t('blog.title')} description={t('blog.description')} lang={lang} path="/blog">
  <section class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
    <h1 class="font-display text-4xl sm:text-5xl">{t('blog.heading')}</h1>

    {
      posts.length === 0 ? (
        <p class="mt-8 text-ink/70">{t('blog.empty')}</p>
      ) : (
        <div class="mt-10 border-t border-line">
          {posts.map((post) => (
            <a
              href={tp(`/blog/${post.id.split('/').pop()}`)}
              class="group block border-b border-line py-6 transition-colors hover:bg-ink/[0.03]"
            >
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h2 class="font-display text-xl group-hover:text-accent">{post.data.title}</h2>
                <time datetime={post.data.pubDate.toISOString()} class="text-sm text-muted">
                  {dateFormatter.format(post.data.pubDate)}
                </time>
              </div>
              <p class="mt-2 max-w-[60ch] text-ink/70">{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <ul class="mt-3 flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <li class="rounded-sm border border-line px-2.5 py-1 text-xs text-muted">{tag}</li>
                  ))}
                </ul>
              )}
            </a>
          ))}
        </div>
      )
    }
  </section>
</Layout>
