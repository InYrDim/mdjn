---
// Light/dark toggle. One hoisted <script> handles every instance via event
// delegation, so it keeps working across Astro View Transitions. The inline
// script in Layout.astro sets data-theme before first paint; this only
// handles clicks and cross-tab sync.
// Icons: Phosphor "moon" and "sun" (regular), MIT — phosphoricons.com
const { size = 18 } = Astro.props;
---

<button
  type="button"
  class="theme-toggle inline-flex h-9 w-9 items-center justify-center rounded-sm text-ink/70 transition-colors hover:bg-ink/[0.06] hover:text-ink"
  aria-label="Switch color theme"
  title="Light / dark"
>
  <svg class="icon-moon" width={size} height={size} viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
    <path
      d="M233.54,142.23a8,8,0,0,0-8-2.88A80.05,80.05,0,0,1,128,34,8,8,0,0,0,116.76,24.46,96,96,0,1,0,231.54,147.94A8,8,0,0,0,233.54,142.23Z"
    ></path>
  </svg>
  <svg class="icon-sun" width={size} height={size} viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
    <path
      d="M120,40V16a8,8,0,0,1,16,0V40a8,8,0,0,1-16,0Zm72,88a64,64,0,1,1-64-64A64.07,64.07,0,0,1,192,128Zm-16,0a48,48,0,1,0-48,48A48.05,48.05,0,0,0,176,128ZM58.34,69.66A8,8,0,0,0,69.66,58.34l-16-16A8,8,0,0,0,42.34,53.66Zm0,116.68l-16,16a8,8,0,0,0,11.32,11.32l16-16a8,8,0,0,0-11.32-11.32ZM192,72a8,8,0,0,0,5.66-2.34l16-16a8,8,0,0,0-11.32-11.32l-16,16A8,8,0,0,0,192,72Zm5.66,114.34a8,8,0,0,0-11.32,11.32l16,16a8,8,0,0,0,11.32-11.32ZM40,120H16a8,8,0,0,0,0,16H40a8,8,0,0,0,0-16Zm80,80a8,8,0,0,0-8,8v24a8,8,0,0,0,16,0V208A8,8,0,0,0,120,200Zm96-80h-24a8,8,0,0,0,0,16h24a8,8,0,0,0,0-16Z"
    ></path>
  </svg>
</button>

<style>
  .icon-sun {
    display: none;
  }

  :global([data-theme='dark']) .icon-sun {
    display: block;
  }

  :global([data-theme='dark']) .icon-moon {
    display: none;
  }
</style>

<script>
  function apply(theme: string) {
    document.documentElement.dataset.theme = theme;
    try {
      localStorage.setItem('theme', theme);
    } catch {
      /* private mode */
    }
  }

  // Delegated click: works for every toggle, on every page, after swaps.
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    if (!target?.closest('.theme-toggle')) return;
    const isDark = document.documentElement.dataset.theme === 'dark';
    apply(isDark ? 'light' : 'dark');
  });

  // Follow manual changes made in other tabs.
  window.addEventListener('storage', (event) => {
    if (event.key === 'theme' && (event.newValue === 'light' || event.newValue === 'dark')) {
      document.documentElement.dataset.theme = event.newValue;
    }
  });
</script>
