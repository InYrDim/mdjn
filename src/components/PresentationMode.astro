---
// Reusable presentation mode. Turns a page's markdown content into a
// keyboard-first slide deck, built at click time from the live DOM — no
// build-time changes, no effect on the static HTML crawlers see.
//
// Deck conventions follow the html-ppt skill: one `.slide` per logical page,
// `.is-active` makes it visible, deck chrome (progress bar + slide counter),
// ← → / Space / Home / End navigation, F fullscreen, Esc exits, #/N hash
// deep-links, and touch swipe. Slides use the site's design tokens, so the
// deck follows the light/dark theme automatically.
//
// Usage (drop into any page that renders markdown content):
//   <PresentationMode contentSelector="article .prose" title={entry.data.title} />
//
// Content is split into slides by heading: the page title becomes the cover,
// each h2/h3 starts a new slide (a heading with no body becomes a section
// divider), hr becomes a divider, and lists longer than 8 items are chunked
// across slides. Mermaid diagrams and code blocks are cloned as rendered.
import { useTranslations, type Lang } from '../i18n/utils';

export interface Props {
  /** CSS selector for the container holding the markdown content to present. */
  contentSelector: string;
  /** Deck title for the cover slide + chrome. Defaults to document.title minus its site suffix. */
  title?: string;
  lang?: Lang;
}

const { contentSelector, title, lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<button
  type="button"
  class="presentation-open fixed right-6 bottom-[4.75rem] z-40 inline-flex h-10 w-10 items-center justify-center rounded-sm border border-line bg-paper/90 text-ink/70 backdrop-blur-sm transition-colors hover:border-accent hover:text-accent print:hidden"
  data-presentation
  data-content-selector={contentSelector}
  data-title={title}
  aria-label={t('presentation.open')}
  title={t('presentation.open')}
>
  <!-- Presentation-screen icon (Lucide "presentation", ISC). -->
  <svg
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M2 3h20"></path>
    <path d="M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3"></path>
    <path d="m7 21 5-5 5 5"></path>
  </svg>
</button>

<div class="pdeck" data-pdeck hidden role="dialog" aria-modal="true" aria-label={title ?? t('presentation.open')}>
  <div class="pdeck-progress" aria-hidden="true"><div class="pdeck-progress-fill" data-pdeck-progress></div></div>

  <div class="pdeck-chrome">
    <span class="pdeck-title" data-pdeck-title>{title}</span>
    <span class="pdeck-counter" data-pdeck-counter aria-live="polite"></span>
    <button
      type="button"
      class="pdeck-close"
      data-pdeck-close
      aria-label={t('presentation.close')}
      title={t('presentation.close')}
    >
      <svg width="14" height="14" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
        <path
          d="M208.49,191.51a12,12,0,0,1-17,17L128,145,64.49,208.49a12,12,0,0,1-17-17L111,128,47.51,64.49a12,12,0,0,1,17-17L128,111l63.51-63.52a12,12,0,0,1,17,17L145,128l63.49,63.51Z"
        ></path>
      </svg>
    </button>
  </div>

  <div class="pdeck-stage" data-pdeck-stage></div>

  <p class="pdeck-hint" aria-hidden="true">{t('presentation.hint')}</p>
</div>

<style is:global>
  /* Lock page scroll while the deck is open. */
  html.presentation-open {
    overflow: hidden;
  }

  .pdeck {
    position: fixed;
    inset: 0;
    z-index: 100;
    background-color: var(--color-paper);
    color: var(--color-ink);
  }

  .pdeck[hidden] {
    display: none;
  }

  .pdeck-stage {
    position: absolute;
    inset: 0;
  }

  /* ---- Slides: html-ppt convention — one .pslide per page, .is-active visible. */
  .pslide {
    position: absolute;
    inset: 0;
    display: none;
  }

  .pslide.is-active {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .pslide.is-active {
      animation: pslide-in 0.35s ease both;
    }

    @keyframes pslide-in {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }

  .pslide-inner {
    width: 100%;
    max-width: 56rem;
    max-height: 100%;
    padding: clamp(1.5rem, 7vw, 4.5rem);
    padding-top: clamp(3.5rem, 9vh, 5.5rem); /* keep clear of the chrome bar */
    overflow: hidden;
    transform-origin: center;
  }

  /* Cover slide */
  .pslide[data-kind='title'] .pslide-inner {
    text-align: center;
  }

  .pslide[data-kind='title'] h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 3.5rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .pslide[data-kind='title'] .pslide-rule {
    display: block;
    width: 4rem;
    height: 3px;
    margin: 1.75rem auto 0;
    background-color: var(--color-accent);
  }

  /* Section divider slide */
  .pslide[data-kind='section'] .pslide-inner {
    border-left: 3px solid var(--color-accent);
  }

  .pslide[data-kind='section'] h2 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4.5vw, 3rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  /* Divider slide (from hr) */
  .pslide[data-kind='divider'] .pslide-inner {
    text-align: center;
    color: var(--color-accent);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1;
  }

  /* Content slide */
  .pslide[data-kind='content'] h3 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.2vw, 2.25rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }

  .pslide-body {
    font-size: clamp(1.05rem, 2vw, 1.4rem);
    line-height: 1.6;
  }

  .pslide-body > * + * {
    margin-top: 1em;
  }

  .pslide-body ul,
  .pslide-body ol {
    padding-left: 1.4em;
    display: grid;
    gap: 0.5em;
  }

  .pslide-body li::marker {
    color: var(--color-accent);
  }

  .pslide-body strong {
    color: var(--color-ink);
  }

  .pslide-body a {
    color: var(--color-accent);
  }

  .pslide-body blockquote {
    border-left: 3px solid var(--color-accent);
    padding-left: 1em;
    color: var(--color-muted);
    font-style: italic;
  }

  .pslide-body pre.astro-code,
  .pslide-body pre.mermaid-rendered {
    font-size: clamp(0.7rem, 1.3vw, 0.95rem);
    max-height: 56vh;
    overflow: auto;
  }

  .pslide-body img {
    display: block;
    max-height: 52vh;
    max-width: 100%;
    width: auto;
    height: auto;
    margin: 0 auto;
    border: 1px solid var(--color-line);
    border-radius: 4px;
  }

  .pslide-body table {
    font-size: 0.9em;
    border-collapse: collapse;
  }

  .pslide-body th,
  .pslide-body td {
    border: 1px solid var(--color-line);
    padding: 0.4em 0.7em;
    text-align: left;
  }

  /* ---- Deck chrome */
  .pdeck-progress {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--color-line);
    z-index: 11;
  }

  .pdeck-progress-fill {
    height: 100%;
    width: 0;
    background-color: var(--color-accent);
    transition: width 0.25s ease;
  }

  .pdeck-chrome {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .pdeck-title {
    font-family: var(--font-mono);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pdeck-counter {
    margin-left: auto;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .pdeck-close {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-line);
    border-radius: 4px;
    color: var(--color-muted);
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .pdeck-close:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .pdeck-hint {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
    opacity: 0.8;
    margin: 0;
  }

  @media (max-width: 640px) {
    .pdeck-title,
    .pdeck-hint {
      display: none;
    }
  }
</style>

<script>
  // Presentation runtime. Event delegation keeps it working across Astro
  // view-transition swaps, same pattern as ShareButton/ThemeToggle.
  //
  // Slides are rebuilt from the live DOM every time the deck opens, so the
  // deck always reflects the page the visitor is reading — including mermaid
  // diagrams, which are cloned in their already-rendered form.

  const MAX_LIST_ITEMS = 8;

  type DeckState = {
    slides: HTMLElement[];
    index: number;
    stage: HTMLElement;
    progress: HTMLElement;
    counter: HTMLElement;
    /** Page state to restore on exit. */
    hash: string;
    scrollY: number;
    path: string;
  };

  let state: DeckState | null = null;

  // ---------- Slide building ----------

  function isMeaningful(el: Element): boolean {
    return Boolean(el.textContent?.trim()) || el.querySelector('img, video, iframe') !== null;
  }

  /** Deep-clone a content block for a slide, stripping runtime-only artifacts. */
  function cloneBlock(node: Element): Node {
    const clone = node.cloneNode(true) as HTMLElement;
    // Copy-code buttons are injected into the live DOM by ArtifactPage; the
    // deck has no clipboard chrome of its own.
    clone.querySelectorAll('.copy-code').forEach((b) => b.remove());
    // Links open in a new tab so a click during a talk can't navigate away.
    clone.querySelectorAll('a[href]').forEach((a) => a.setAttribute('target', '_blank'));
    return clone;
  }

  function makeSlide(
    kind: 'title' | 'section' | 'divider' | 'content',
    heading: string,
    blocks: Element[],
    deckTitle: string,
  ): HTMLElement {
    const slide = document.createElement('section');
    slide.className = 'pslide';
    slide.dataset.kind = kind;

    const inner = document.createElement('div');
    inner.className = 'pslide-inner';

    if (kind === 'title') {
      const h = document.createElement('h2');
      h.textContent = deckTitle;
      inner.append(h, Object.assign(document.createElement('span'), { className: 'pslide-rule' }));
    } else if (kind === 'section') {
      const h = document.createElement('h2');
      h.textContent = heading;
      inner.appendChild(h);
    } else if (kind === 'divider') {
      inner.textContent = '· · ·';
    } else {
      if (heading) {
        const h = document.createElement('h3');
        h.textContent = heading;
        inner.appendChild(h);
      }
      const body = document.createElement('div');
      body.className = 'pslide-body';
      for (const block of blocks) body.appendChild(cloneBlock(block));
      inner.appendChild(body);
    }

    slide.appendChild(inner);
    return slide;
  }

  /**
   * Split the page's content into slides: the deck title becomes the cover,
   * every h1–h3 starts a new slide, hr renders a divider, and over-long lists
   * are chunked so no slide overflows.
   */
  function buildSlides(source: Element, deckTitle: string): HTMLElement[] {
    const slides: HTMLElement[] = [makeSlide('title', '', [], deckTitle)];

    let heading = '';
    let blocks: Element[] = [];

    const flush = () => {
      const slideHeading = heading;
      const slideBlocks = blocks;
      heading = '';
      blocks = [];

      if (slideBlocks.length === 0) {
        // A heading with no body under it is a pure section divider.
        if (slideHeading) slides.push(makeSlide('section', slideHeading, [], deckTitle));
        return;
      }

      let group: Element[] = [];
      const pushGroup = () => {
        if (group.length > 0) {
          slides.push(makeSlide('content', slideHeading, group, deckTitle));
          group = [];
        }
      };

      for (const block of slideBlocks) {
        if (!isMeaningful(block)) continue;

        // Chunk long lists across slides so nothing falls off the slide.
        if (block.tagName === 'UL' || block.tagName === 'OL') {
          const items = Array.from(block.children).filter((c) => c.tagName === 'LI');
          if (items.length > MAX_LIST_ITEMS) {
            for (let i = 0; i < items.length; i += MAX_LIST_ITEMS) {
              pushGroup();
              const chunk = block.cloneNode(false) as HTMLElement;
              for (const li of items.slice(i, i + MAX_LIST_ITEMS)) chunk.appendChild(cloneBlock(li));
              slides.push(makeSlide('content', slideHeading, [chunk], deckTitle));
            }
            continue;
          }
        }

        group.push(block);
      }
      pushGroup();
    };

    for (const el of Array.from(source.children)) {
      if (/^H[1-3]$/.test(el.tagName)) {
        flush();
        heading = el.textContent?.trim() ?? '';
        continue;
      }
      if (el.tagName === 'HR') {
        flush();
        slides.push(makeSlide('divider', '', [], deckTitle));
        continue;
      }
      blocks.push(el);
    }
    flush();

    return slides;
  }

  // ---------- Navigation ----------

  function show(index: number) {
    if (!state) return;
    const clamped = Math.max(0, Math.min(index, state.slides.length - 1));
    state.index = clamped;

    state.slides.forEach((slide, i) => slide.classList.toggle('is-active', i === clamped));
    state.counter.textContent = `${clamped + 1} / ${state.slides.length}`;
    state.progress.style.width = `${((clamped + 1) / state.slides.length) * 100}%`;

    // #/N deep-link, per the html-ppt runtime convention.
    history.replaceState(null, '', `#/${clamped + 1}`);
    fitSlide(state.slides[clamped]);
  }

  /** Scale a slide's content down if it would overflow the viewport. */
  function fitSlide(slide: HTMLElement) {
    const inner = slide.querySelector<HTMLElement>('.pslide-inner');
    if (!inner) return;
    inner.style.transform = '';
    const overflow = inner.scrollHeight - slide.clientHeight;
    if (overflow > 8) {
      const scale = Math.max(0.55, slide.clientHeight / inner.scrollHeight);
      inner.style.transform = `scale(${scale})`;
    }
  }

  function toggleFullscreen() {
    const deck = document.querySelector<HTMLElement>('[data-pdeck]');
    if (!deck) return;
    if (document.fullscreenElement) {
      void document.exitFullscreen().catch(() => {});
    } else {
      void deck.requestFullscreen?.().catch(() => {});
    }
  }

  // ---------- Open / close ----------

  function openDeck(button: HTMLElement) {
    const deck = document.querySelector<HTMLElement>('[data-pdeck]');
    const stage = deck?.querySelector<HTMLElement>('[data-pdeck-stage]');
    const source = document.querySelector(button.dataset.contentSelector ?? '');
    if (!deck || !stage || !source || state) return;

    const deckTitle =
      button.dataset.title || document.title.replace(/\s+-\s+[^-]+$/, '') || document.title;
    deck.querySelector<HTMLElement>('[data-pdeck-title]')!.textContent = deckTitle;

    const slides = buildSlides(source, deckTitle);
    if (slides.length === 0) return;
    stage.replaceChildren(...slides);

    state = {
      slides,
      index: 0,
      stage,
      progress: deck.querySelector<HTMLElement>('[data-pdeck-progress]')!,
      counter: deck.querySelector<HTMLElement>('[data-pdeck-counter]')!,
      hash: window.location.hash,
      scrollY: window.scrollY,
      path: window.location.pathname,
    };

    deck.hidden = false;
    document.documentElement.classList.add('presentation-open');

    // Restore a #/N deep-link if the page was opened with one.
    const deepLink = /^#\/(\d+)$/.exec(window.location.hash);
    show(deepLink ? Number(deepLink[1]) - 1 : 0);
    deck.querySelector<HTMLButtonElement>('[data-pdeck-close]')?.focus();
  }

  function closeDeck() {
    if (!state) return;
    const saved = state;
    state = null;

    document.querySelector<HTMLElement>('[data-pdeck]')?.setAttribute('hidden', '');
    document.documentElement.classList.remove('presentation-open');
    if (document.fullscreenElement) void document.exitFullscreen().catch(() => {});

    // Restore the page exactly as it was: hash, scroll position.
    history.replaceState(null, '', saved.path + saved.hash);
    window.scrollTo({ top: saved.scrollY, behavior: 'instant' as ScrollBehavior });
  }

  // ---------- Events (delegated, survive view-transition swaps) ----------

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    if (!target) return;

    const openButton = target.closest<HTMLElement>('[data-presentation]');
    if (openButton) {
      event.preventDefault();
      openDeck(openButton);
      return;
    }

    if (!state || !target.closest('[data-pdeck]')) return;

    if (target.closest('[data-pdeck-close]')) {
      closeDeck();
      return;
    }

    // Let links and text selection inside slides work instead of navigating.
    if (target.closest('a, button, input, textarea, pre, table')) return;

    // Left third of the deck goes back, the rest advances.
    const width = window.innerWidth;
    show(event.clientX < width * 0.3 ? state.index - 1 : state.index + 1);
  });

  document.addEventListener('keydown', (event) => {
    if (!state || event.ctrlKey || event.metaKey || event.altKey) return;

    switch (event.key) {
      case 'ArrowRight':
      case 'PageDown':
      case ' ':
        event.preventDefault();
        show(state.index + 1);
        break;
      case 'ArrowLeft':
      case 'PageUp':
        event.preventDefault();
        show(state.index - 1);
        break;
      case 'Home':
        event.preventDefault();
        show(0);
        break;
      case 'End':
        event.preventDefault();
        show(state.slides.length - 1);
        break;
      case 'f':
      case 'F':
        toggleFullscreen();
        break;
      case 'Escape':
        closeDeck();
        break;
    }
  });

  // Touch swipe navigation (html-ppt runtime behavior for phones/tablets).
  let touchStart: { x: number; y: number } | null = null;

  document.addEventListener(
    'touchstart',
    (event) => {
      if (!state || event.touches.length !== 1) return;
      const target = event.target as HTMLElement | null;
      if (!target?.closest('[data-pdeck]')) return;
      touchStart = { x: event.touches[0].clientX, y: event.touches[0].clientY };
    },
    { passive: true },
  );

  document.addEventListener(
    'touchend',
    (event) => {
      if (!state || !touchStart) return;
      const target = event.target as HTMLElement | null;
      if (!target?.closest('[data-pdeck]')) return;
      const dx = event.changedTouches[0].clientX - touchStart.x;
      const dy = event.changedTouches[0].clientY - touchStart.y;
      touchStart = null;
      if (Math.abs(dx) < 40 || Math.abs(dy) >= Math.abs(dx)) return;
      show(state.index + (dx < 0 ? 1 : -1));
    },
    { passive: true },
  );

  window.addEventListener('resize', () => {
    if (!state) return;
    fitSlide(state.slides[state.index]);
  });

  // Navigating away mid-presentation (browser back etc.): drop the deck
  // without restoring the old page's hash/scroll.
  document.addEventListener('astro:before-swap', () => {
    if (!state) return;
    state = null;
    document.documentElement.classList.remove('presentation-open');
  });
</script>
